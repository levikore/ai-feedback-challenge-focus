# Leave ANTHROPIC_API_KEY unset to run entirely on the deterministic FakeProvider.
# The app boots, analyses, and passes its tests with no credentials at all.
# ANTHROPIC_API_KEY=sk-ant-...

PORT=3000
DATABASE_PATH=./data/feedback.db

# Model used for analysis. Override to trade cost for latency.
ANTHROPIC_MODEL=claude-opus-5

# Output ceiling per analysis. Raise it if you see FAILED items whose error
# reads "truncated" - that means the model ran out of room mid-answer.
ANTHROPIC_MAX_TOKENS=4096

# Number of feedback items analysed concurrently by the in-process worker pool.
WORKER_CONCURRENCY=2

# Transient-failure retries per feedback item, on top of the first attempt.
MAX_ANALYSIS_ATTEMPTS=3

# Reject submissions longer than this (characters).
MAX_FEEDBACK_LENGTH=5000

# Set to "fake" to force the deterministic provider even when a key is present.
AI_PROVIDER=auto

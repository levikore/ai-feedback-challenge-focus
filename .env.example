# ---------------------------------------------------------------------------
# AI provider
#
# The app supports two real LLM providers and a deterministic fake one.
# Set ONE key and it is used automatically.
#
#   Gemini    — free tier, no credit card: https://aistudio.google.com
#               (EEA/UK/Switzerland must enable billing even for free models)
#   Anthropic — paid: https://console.anthropic.com
#
# With neither key set, the app runs on the FakeProvider so it works with no
# credentials at all. Analyses are then SIMULATED, not produced by a model.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
GEMINI_MAX_TOKENS=4096

# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096

# auto (default) = Gemini key, else Anthropic key, else fake.
# Naming one explicitly (gemini | anthropic | fake) is honoured, and the app
# refuses to start if the key for a named provider is missing — asking for a
# real model and silently getting a simulated one is the worst outcome.
AI_PROVIDER=auto

# ---------------------------------------------------------------------------
# Server and storage
# ---------------------------------------------------------------------------

PORT=3000
DATABASE_PATH=./data/feedback.db

# Feedback items analysed concurrently by the in-process worker pool.
WORKER_CONCURRENCY=2

# Total attempts per item, including the first. Only transient failures retry.
MAX_ANALYSIS_ATTEMPTS=3

# Submissions longer than this (characters) are rejected with 400.
MAX_FEEDBACK_LENGTH=5000
